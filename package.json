{
  "name": "voice-chat-bot",
  "version": "1.1.1",
  "description": "Discord temporary voice rooms with per-server ownership and safe cleanup",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && cp -r src/db/migrations dist/db/",
    "start": "node dist/index.js",
    "deploy-commands": "tsx src/deploy-commands.ts",
    "migrate": "tsx src/db/migrate.ts",
    "lint": "eslint src",
    "format": "prettier --write src tests scripts .github docs README.md RESET.md CHANGELOG.md package.json",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "test": "node --import tsx --test tests/*.test.ts",
    "format:check": "prettier --check src tests scripts .github docs README.md RESET.md CHANGELOG.md package.json",
    "check:style": "node scripts/check-style.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "discord.js": "^14.16.0",
    "dotenv": "^16.4.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.0",
    "eslint": "^9.15.0",
    "typescript-eslint": "^8.15.0",
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "license": "SEE LICENSE IN LICENSE"
}
